[Unit]
Description=llama-server panel control
# The tray icon has nowhere to live without a graphical session, and should go
# away with it. It does not need the shell to be up *first*: the process waits
# for the StatusNotifierWatcher name and builds the icon when it appears.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=exec
ExecStart=%h/.local/bin/llama-tray
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
